# Backend configuration (copy to backend/.env)
APP_NAME=VidyaSetu AI
ENVIRONMENT=development
DATABASE_URL=sqlite:///./vidyasetu.db
# Replace this with a long random secret before any deployment.
JWT_SECRET_KEY=replace-with-a-long-random-secret-before-deployment
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
FRONTEND_URL=http://localhost:5173
# Optional: live tutor answers are disabled until this is configured.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
